{
    "name": "tui",
    "version": "0.2.1",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "pnpm typecheck && nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "exec prettier . --write",
        "pretest": "pnpm pretest:e2e",
        "test": "NODE_OPTIONS=--max-old-space-size=5120 vitest run",
        "test:unit": "vitest run --project unit",
        "test:nuxt": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project nuxt",
        "pretest:e2e": "playwright install chromium && nuxt build",
        "test:e2e": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project e2e",
        "test:coverage": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project unit --project nuxt --coverage"
    },
    "dependencies": {
        "@bbob/html": "4.4.1",
        "@bbob/plugin-helper": "4.4.1",
        "@bbob/preset-html5": "4.4.1",
        "@nuxt/eslint": "1.17.0",
        "@nuxt/image": "2.1.0",
        "@nuxt/ui": "4.11.0",
        "@seald-io/nedb": "4.1.2",
        "consola": "3.4.2",
        "create-torrent": "6.1.3",
        "eslint": "^10.10.0",
        "isomorphic-dompurify": "^4.1.0",
        "nuxt": "4.5.2",
        "parse-torrent": "11.0.24",
        "tailwindcss": "4.3.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@bbob/types": "4.4.1",
        "@iconify-json/heroicons": "1.2.3",
        "@iconify-json/lucide": "^1.2.129",
        "@iconify-json/material-symbols": "^1.2.90",
        "@iconify-json/qlementine-icons": "1.2.16",
        "@nuxt/test-utils": "^4.2.0",
        "@testing-library/user-event": "^14.6.7",
        "@testing-library/vue": "8.1.0",
        "@types/create-torrent": "6.1.1",
        "@types/parse-torrent": "11.0.1",
        "@vitest/coverage-istanbul": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/test-utils": "^2.5.0",
        "eslint-config-prettier": "10.1.8",
        "happy-dom": "^20.14.0",
        "playwright": "1.63.0",
        "pnpm": "12.3.4",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "vitest": "^4.1.11",
        "vue-tsc": "3.3.11"
    }
}
