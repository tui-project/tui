{
    "name": "tui",
    "version": "0.2.0",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "pnpm typecheck && nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "exec prettier . --write",
        "test": "pnpm test:unit && pnpm test:nuxt && pnpm test:e2e",
        "test:unit": "vitest run --project unit",
        "test:nuxt": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project nuxt",
        "pretest:e2e": "playwright install chromium",
        "test:e2e": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project e2e",
        "test:coverage": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project unit --project nuxt --coverage"
    },
    "dependencies": {
        "@bbob/html": "4.4.1",
        "@bbob/plugin-helper": "4.4.1",
        "@bbob/preset-html5": "4.4.1",
        "@nuxt/eslint": "1.17.0",
        "@nuxt/image": "2.1.0",
        "@nuxt/ui": "4.11.0",
        "@seald-io/nedb": "4.1.2",
        "consola": "3.4.2",
        "create-torrent": "6.1.3",
        "eslint": "10.9.0",
        "nuxt": "4.5.2",
        "parse-torrent": "11.0.24",
        "tailwindcss": "4.3.3",
        "vue": "3.5.41",
        "vue-router": "5.2.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@bbob/types": "4.4.1",
        "@iconify-json/heroicons": "1.2.3",
        "@iconify-json/lucide": "1.2.125",
        "@iconify-json/material-symbols": "1.2.89",
        "@iconify-json/qlementine-icons": "1.2.15",
        "@nuxt/test-utils": "4.1.0",
        "@testing-library/user-event": "14.6.6",
        "@testing-library/vue": "8.1.0",
        "@types/create-torrent": "6.1.1",
        "@types/parse-torrent": "11.0.1",
        "@vitest/coverage-istanbul": "4.1.10",
        "@vitest/coverage-v8": "4.1.10",
        "@vue/test-utils": "2.4.11",
        "eslint-config-prettier": "10.1.8",
        "happy-dom": "20.11.6",
        "playwright": "1.62.1",
        "pnpm": "11.23.0",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "vitest": "4.1.10",
        "vue-tsc": "3.3.11"
    }
}
