{
    "name": "tui",
    "version": "0.2.3",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "pnpm typecheck && nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "exec prettier . --write",
        "pretest": "pnpm pretest:e2e",
        "test": "NODE_OPTIONS=--max-old-space-size=5120 vitest run",
        "test:unit": "vitest run --project unit",
        "test:nuxt": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project nuxt",
        "pretest:e2e": "playwright install chromium && nuxt build",
        "test:e2e": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project e2e",
        "test:coverage": "NODE_OPTIONS=--max-old-space-size=5120 vitest run --project unit --project nuxt --coverage"
    },
    "dependencies": {
        "@bbob/html": "^4.4.1",
        "@bbob/plugin-helper": "^4.4.1",
        "@bbob/preset-html5": "^4.4.1",
        "@nuxt/eslint": "^1.17.0",
        "@nuxt/image": "^2.2.0",
        "@nuxt/ui": "^4.12.0",
        "@seald-io/nedb": "^4.1.2",
        "consola": "^3.4.2",
        "create-torrent": "^6.1.3",
        "eslint": "^10.13.0",
        "isomorphic-dompurify": "^4.6.0",
        "nuxt": "^4.6.2",
        "parse-torrent": "^11.0.24",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@bbob/types": "^4.4.1",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/lucide": "^1.2.146",
        "@iconify-json/material-symbols": "^1.2.95",
        "@iconify-json/qlementine-icons": "^1.2.16",
        "@nuxt/test-utils": "^4.3.4",
        "@testing-library/user-event": "^14.6.8",
        "@testing-library/vue": "^8.1.0",
        "@types/create-torrent": "^6.1.1",
        "@types/parse-torrent": "^11.0.1",
        "@vitest/coverage-istanbul": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "eslint-config-prettier": "^10.1.8",
        "happy-dom": "^21.0.3",
        "playwright": "^1.64.1",
        "pnpm": "^12.14.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    }
}
